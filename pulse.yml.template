name: Daily Client Pulse

on:
  schedule:
    - cron: "5 13 * * *"   # 13:05 UTC = 6:05 AM Phoenix, daily
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  pulse:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Run pulse pipeline
        env:
          VISTA_API_KEY: ${{ secrets.VISTA_API_KEY }}
          NOTION_TOKEN: ${{ secrets.NOTION_TOKEN }}
        run: python scripts/pulse.py

      - name: Commit data files
        run: |
          git config user.name "pulse-bot"
          git config user.email "actions@github.com"
          git add data*.json
          git diff --cached --quiet && echo "no changes" || \
            (git commit -m "Daily pulse update $(date -u +%F)" && git push)
